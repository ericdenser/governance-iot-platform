# Overrides pros defaults do compose genérico rodando na VM mackleaps-apps.
# Uso: cp deploy/mackcloud/shared/.env.example ../../.env  (na raiz do repo)

# ── Database ─────────────────────────────────────────────────
DB_USERNAME=iot
DB_PASSWORD=CHANGE_ME
POSTGRES_DB=cmdb_iot
EVENT_HANDLER_DB=event_handler
DB_HOST=iot-postgres
DB_PORT=5432

# ── Squid corporativo ────────────────────────────────────────
PROXY_ACTIVE=true
PROXY_HOST=172.16.50.1
PROXY_PORT=8080
PROXY_USER=mackcloud
PROXY_PASSWORD=cloud2019

JAVA_TOOL_OPTIONS=-Dhttps.proxyHost=172.16.50.1 -Dhttps.proxyPort=8080 -Dhttps.proxyUser=mackcloud -Dhttps.proxyPassword=cloud2019 -Dhttp.proxyHost=172.16.50.1 -Dhttp.proxyPort=8080 -Dhttp.proxyUser=mackcloud -Dhttp.proxyPassword=cloud2019 -Dhttp.nonProxyHosts=localhost|127.0.0.1|iot-*|172.16.50.*

# ── Rede docker ──────────────────────────────────────────────
DOCKER_NETWORK=iot-net
DOCKER_NETWORK_EXTERNAL=true

# ── Keycloak (compartilhado do lab) ──────────────────────────
KEYCLOAK_ISSUER_URI=https://mackleaps.mackenzie.br/keycloak/realms/IOT-REALM
KEYCLOAK_ADMIN_URL=https://mackleaps.mackenzie.br/keycloak/admin/realms/IOT-REALM
GOVAPI_CLIENT_ID=gov-api
GOVAPI_CLIENT_SECRET=CHANGE_ME
AGENT_MQTT_CLIENT_SECRET=CHANGE_ME
EVENT_HANDLER_CLIENT_SECRET=CHANGE_ME
BFF_CLIENT_ID=iot-bff
BFF_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_CLIENT_ID=iot-bff
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ── Influx (compartilhado do lab) ────────────────────────────
INFLUX_URL=https://mackleaps.mackenzie.br/influx
INFLUX_TOKEN=CHANGE_ME
INFLUX_ORG=mackenzie
INFLUX_BUCKET=telemetry_iot

# ── MinIO ────────────────────────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=iot-govapi
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=firmware
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://iot-minio:9000
MINIO_PUBLIC_ENDPOINT=https://mackleaps.mackenzie.br/IOT/minio

# ── URLs entre serviços ──────────────────────────────────────
GOVAPI_URL=http://iot-govapi:8082
GOV_API_URL=http://iot-govapi:8082
EVENT_HANDLER_URL=http://iot-event-handler:8085
AGENT_URL=http://iot-agent-mqtt:8087
GOVAPI_SELF_URL=https://mackleaps.mackenzie.br/IOT/govapi

# ── URLs públicas ────────────────────────────────────────────
FRONTEND_URL=https://mackleaps.mackenzie.br/IOT
BFF_PUBLIC_URL=https://mackleaps.mackenzie.br/IOT/bff
GOVAPI_PUBLIC_URL=https://mackleaps.mackenzie.br/IOT/govapi

# ── MQTT ─────────────────────────────────────────────────────
MQTT_BROKER_URL=tcp://iot-broker:1883
MQTT_BROKER_HOST=iot-broker
MQTT_JWT_REFRESH_INTERVAL_MS=1800000
BROADCAST_WAVE_THRESHOLD=100
BROADCAST_WAVE_SIZE=50
BROADCAST_WAVE_INTERVAL_MS=10000

# ── Redis ────────────────────────────────────────────────────
REDIS_STREAMS_HOST=iot-redis-streams
REDIS_STREAMS_PORT=6379
REDIS_HOST=iot-redis
REDIS_PORT=6379

# ── Container names ──────────────────────────────────────────
GOVAPI_CONTAINER_NAME=iot-govapi
BFF_CONTAINER_NAME=iot-bff
SPA_CONTAINER_NAME=iot-spa
AGENT_MQTT_CONTAINER_NAME=iot-agent-mqtt
EVENT_HANDLER_CONTAINER_NAME=iot-event-handler
DATALOGGER_CONTAINER_NAME=iot-datalogger

# ── Portas host (127.0.0.1 — só nginx-frontend alcança) ──────
GOVAPI_HOST_PORT=18082
GOVAPI_HOST_BIND=127.0.0.1
BFF_HOST_PORT=18083
BFF_HOST_BIND=127.0.0.1
SPA_HOST_PORT=18100
SPA_HOST_BIND=127.0.0.1

# ── BFF session cookie (HTTPS prod) ──────────────────────────
APP_SESSION_COOKIE_SECURE=true
APP_SESSION_COOKIE_SAME_SITE=Lax
APP_SESSION_COOKIE_PATH=/IOT/bff

# ── SPA build ────────────────────────────────────────────────
SPA_BASE_PATH=/IOT/
NPM_PROXY_URL=http://mackcloud:cloud2019@172.16.50.1:8080
NPM_NO_PROXY=localhost,127.0.0.1,172.16.50.*

# ── Provisionamento ──────────────────────────────────────────
NVS_PYTHON_PATH=python3
NVS_SCRIPT_PATH=/opt/nvs_partition_gen.py
PROVISIONING_BOOTLOADER_BIN_PATH=/opt/provisioning-bins/bootloader.bin
PROVISIONING_PARTITION_TABLE_BIN_PATH=/opt/provisioning-bins/partition-table.bin
PROVISIONING_BINS_VOLUME=./provisioning-bins

# ── Limites RAM ──────────────────────────────────────────────
GOVAPI_MEMORY_LIMIT=640M
BFF_MEMORY_LIMIT=512M
SPA_MEMORY_LIMIT=64M
AGENT_MQTT_MEMORY_LIMIT=512M
EVENT_HANDLER_MEMORY_LIMIT=512M
DATALOGGER_MEMORY_LIMIT=448M
