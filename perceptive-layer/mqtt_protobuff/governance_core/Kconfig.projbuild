menu "WiFi Manager Configuration"

    config WIFI_SSID
        string "Main SSID"
        default "Myssid"

    config WIFI_PASSWORD
        string "Main Password"
        default "Mypassword"

    config WIFI_MAX_RETRIES
        int "Max Retries"
        default 5

    choice WIFI_FAILURE_STRATEGY
        prompt "Recovery Strategy on Failure"
        default WIFI_RECOVERY_RESET
        help
            Define o comportamento quando o número máximo de tentativas é atingido.

        config WIFI_RECOVERY_RESET
            bool "System Reset"
            help
                Reinicia o ESP32 automaticamente (esp_restart).

        config WIFI_RECOVERY_SWAP
            bool "Swap SSID (Try Backup Network)"
            help
                Tenta conectar em uma rede secundária definida abaixo.
                Se a rede secundária também falhar, o sistema reinicia.

        config WIFI_RECOVERY_NONE
            bool "Keep Idle (Manual Handling)"
            help
                Apenas para o driver e define o estado como FAILED.
                A aplicação deve decidir o que fazer.
    endchoice

    # CREDENCIAIS DE BACKUP (Só aparecem se SWAP for escolhido)
    config WIFI_BACKUP_SSID
        string "Backup SSID"
        depends on WIFI_RECOVERY_SWAP
        default "Backup_Network"

    config WIFI_BACKUP_PASSWORD
        string "Backup Password"
        depends on WIFI_RECOVERY_SWAP
        default ""

endmenu

menu "Governance IoT"

    config GOV_MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtts://xxx.xxx.xx.xx:8883"
        help
            URI completa do broker MQTT. O esquema define o transporte:
              mqtts://host:8883        — TLS direto
              mqtt://host:1883         — sem TLS
            Exemplos:
              mqtts://xxx.xxx.xx.xx:8883
              mqtts://iot.mackenzie.br:8883

    config GOV_GPS_POWER_PIN
        int "GPS power control GPIO"
        default 5
        help
            GPIO que controla o transistor PNP de alimentação do módulo GPS.
            Level 1 = GPS ligado, level 0 = desligado.

    config GOV_GPS_UART_TX_PIN
        int "GPS UART TX GPIO (ESP TX → GPS RX)"
        default 17

    config GOV_GPS_UART_RX_PIN
        int "GPS UART RX GPIO (ESP RX ← GPS TX)"
        default 18

    config GOV_GPS_UART_PORT
        int "GPS UART port number"
        default 1

    config GOV_TELEMETRY_INTERVAL_MS
        int "Telemetry publish interval (ms)"
        default 5000

    config GOV_STATUS_INTERVAL_MS
        int "Status publish interval (ms)"
        default 30000

    config GOV_MAX_WIFI_RETRIES
        int "Max WiFi connect retries antes de setar erro"
        default 10

    config GOV_MAX_CRASH_COUNT
        int "Max crash count antes de invalidar firmware"
        default 3

    config GOV_GPS_SYNC_EVERY_N_BOOTS
        int "Corrigir DS3231 com GPS a cada N boots"
        default 24

    config GOV_EXTERNAL_TIME_TIMEOUT_MS
        int "Timeout do get_external_time hook (ms)"
        default 45000
        help
            Tempo máximo que o hook get_external_time tem pra obter hora.
            Cold start de GPS pode passar de 30s. Aumenta se GPS demora
            demais no boot inicial (ou considera ligar o GPS antes de
            governance_core_init pra warm start).

    config GOV_OTA_JITTER_MAX_MS
        int "OTA download jitter maximo (ms)"
        default 10000
        help
            Atraso aleatorio (0..N ms) antes de iniciar o download OTA.
            Espalha os downloads de uma wave para nao saturar o object storage quando varios
            devices recebem o comando no mesmo instante. 0 desativa o jitter.
            
     config GOV_DEEP_SLEEP_OPERATIONAL_TIMEOUT_S
            int "Timeout no OPERATIONAL antes de dormir sem publicar (s)"
            range 15 600
            default 60
            help
                Se em N segundos no OPERATIONAL nao conseguir publicar telemetria
                E status (ex: MQTT desconectado, WiFi caindo), dorme mesmo assim
                pra nao drenar bateria acordado infinitamente. Proximo wake tenta
                de novo. 60s cobre reconnect WiFi + fetch JWT + connect MQTT +
                buffer de retry.
                
    menuconfig GOV_BATTERY_HIBERNATION
        bool "Hibernar em bateria critica"
        default n 
        help 
            Se habilitado, entre em deep sleep quando battery_mv cair
            abaixo do limite critico. Requer hook get_battery_mv registrado.
            Publica status CRITICAL_BATTERY (24) antes de dormir.
        if GOV_BATTERY_HIBERNATION

            config GOV_BATTERY_CRITICAL_MV
                int "Limite critico (mV)"
                range 2800 4100
                default 3200
                help 
                    Abaixo desse valor por N leituras consecutivas, dorme.
                
            config GOV_BATTERY_HYSTERESIS_MV
                int "Histerese pra sair da hibernacao (mV)"
                range 100 1000
                default 400
                help 
                    So volta pro modo ativo quando bateria ficar acima de CRITICAL + HYSTERESIS.

            config GOV_BATTERY_CRITICAL_STREAK
                int "Leituras consecutivas antes de hibernar"
                range 1 20
                default 5
                help
                    Filtro anti-glitch de ADC. 

            config GOV_BATTERY_WAKE_INTERVAL_S
                int "Timer wake pra reavaliar (segundos)"
                range 60 86400
                default 3600
                help
                    A cada N segundos acorda, le bateria, decide se dorme de novo ou nao.
        endif

    config GOV_BOOT_TIMEOUT_S
        int "Boot watchdog timeout (s)"
        range 60 600
        default 120
        help
            Se o firmware nao chegar em OPERATIONAL em N segundos apos boot,
            forca esp_restart(). Recupera de estados intermediarios travados
            (JWT sem resposta, MQTT em WAITING_CONNECT eterno, etc).
            Independente do task watchdog do FreeRTOS — este pega loops
            logicos onde tasks yieldam mas nunca progridem.

    menuconfig GOV_FIRMWARE_DEEP_SLEEP
        bool "Enable deep sleep"
        default n
        help 
            Se habilitado, o firmware entra em estado de deep sleep após cada ciclo

        if GOV_FIRMWARE_DEEP_SLEEP

            config DEEP_SLEEP_WAKE_INTERVAL_S
                int "Timer para dispositivo acordar"
                range 60 86400
                default 300
                help
                    A cada N segundos o dispositivo acorda, termina o ciclo e volta a dormir
        endif


endmenu

