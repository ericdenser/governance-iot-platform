# Copie para .env e preencha:  cp .env.example .env

# ── Rede ─────────────────────────────────────────────────────
# IP LAN da máquina que os devices enxergam (montar MINIO_PUBLIC_ENDPOINT, MQTT broker, etc)
HOST_IP=COLOQUE_O_IP_AQUI

# ── Database ─────────────────────────────────────────────────
DB_USERNAME=admin
DB_PASSWORD=changeme

# ── Redis Streams (contrato: docs/REDIS_STREAMS_CONTRACT.md) ─
REDIS_STREAMS_HOST=localhost
REDIS_STREAMS_PORT=6380
REDIS_STREAMS_PASSWORD=
# REPLICA_ID=0

# ── InfluxDB ─────────────────────────────────────────────────
INFLUX_USERNAME=admin
INFLUX_PASSWORD=changeme
INFLUX_TOKEN=changeme-influx-token

# ── govApi (mTLS) ────────────────────────────────────────────
# INFRA_API_KEY: chave que o infra-executor usa pra bater no govApi (X-Infra-Key)
# CA_PASSWORD:   senha do rootCA.p12 que assina os certs dos devices
INFRA_API_KEY=changeme
CA_PASSWORD=changeme

# ── agent-mqtt (mTLS Mosquitto) ──────────────────────────────
AGENT_KEYSTORE_PASS=changeme
AGENT_TRUSTSTORE_PASS=changeme

# ── Provisionamento (NVS binary + bootloader) ────────────────
# Opção A — máquina com ESP-IDF instalado:
#   NVS_PYTHON_PATH=~/.espressif/tools/python/<ver>/venv/bin/python3
#   NVS_SCRIPT_PATH=~/.espressif/<ver>/esp-idf/components/nvs_flash/nvs_partition_generator/nvs_partition_gen.py
# Opção B — sem ESP-IDF, usar o pacote pip:
#   pip install --user esp-idf-nvs-partition-gen
#   NVS_PYTHON_PATH=python3
#   NVS_SCRIPT_PATH=   (deixe vazio — govApi roda via `python3 -m esp_idf_nvs_partition_gen`)
NVS_PYTHON_PATH=python3
NVS_SCRIPT_PATH=
PROVISIONING_BOOTLOADER_BIN_PATH=/caminho/para/GOVERNANCE_FIRMWARE/build/bootloader/bootloader.bin
PROVISIONING_PARTITION_TABLE_BIN_PATH=/caminho/para/GOVERNANCE_FIRMWARE/build/partition_table/partition-table.bin

# ── MinIO (setup: docs/FIRMWARE_STORAGE_OPERATIONS.md) ───────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://${HOST_IP}:9000
MINIO_BUCKET=firmware
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_REGION=us-east-1

# ── OTA broadcast em waves (docs/OTA_ROLLOUT_TUNING.md) ──────
BROADCAST_WAVE_THRESHOLD=100
BROADCAST_WAVE_SIZE=50
BROADCAST_WAVE_INTERVAL_MS=10000

# ── URLs entre serviços ──────────────────────────────────────
AGENT_URL=http://localhost:8087
EVENT_URL=http://localhost:8085
GOVAPI_SELF_URL=http://localhost:8082
GOV_API_URL=http://localhost:8082
FRONTEND_URL=http://localhost:5173

# ── BFF / Keycloak ───────────────────────────────────────────
KEYCLOAK_ISSUER_URI=http://${HOST_IP}:8080/realms/IOT-REALM
KEYCLOAK_ADMIN_URL=http://${HOST_IP}:8080/admin/realms/IOT-REALM
KEYCLOAK_CLIENT_ID=iot-bff
KEYCLOAK_CLIENT_SECRET=changeme
# KEYCLOAK_ADMIN_PASSWORD=admin

# ── Service accounts M2M ─────────────────────────────────────
AGENT_MQTT_CLIENT_SECRET=changeme
EVENT_HANDLER_CLIENT_SECRET=changeme
GOVAPI_CLIENT_SECRET=changeme
BFF_CLIENT_SECRET=changeme

# ============================================================
# DEPLOY DOCKER (opcional — só se usar os docker-compose.yml
# dos serviços; ignore para dev com mvn spring-boot:run)
# ============================================================

# Proxy corporativo pro build (Maven + apk + pip). Deixe false se não usa proxy.
PROXY_ACTIVE=false
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASSWORD=
# Usado por apk/pip no runtime stage do Dockerfile do govApi.
# Ex: PROXY_URL=http://user:pass@host:port
PROXY_URL=

# Rede docker compartilhada entre composes.
# Se external=true, criar antes: docker network create ${DOCKER_NETWORK}
DOCKER_NETWORK=app-net
DOCKER_NETWORK_EXTERNAL=false

# Overrides opcionais (container names, portas host, limites de RAM, etc)
# GOVAPI_CONTAINER_NAME=govapi
# GOVAPI_HOST_PORT=8082
# GOVAPI_HOST_BIND=127.0.0.1
# GOVAPI_MEMORY_LIMIT=640M
# BFF_CONTAINER_NAME=bff
# BFF_HOST_PORT=8083
# JAVA_TOOL_OPTIONS=-Dhttps.proxyHost=... -Dhttps.proxyPort=...

# SPA build
# SPA_BASE_PATH=/
# BFF_PUBLIC_URL=http://localhost:8083
# NPM_PROXY_URL=

# BFF session cookie (prod HTTPS: Secure=true)
# APP_SESSION_COOKIE_SECURE=false
# APP_SESSION_COOKIE_SAME_SITE=Lax
# APP_SESSION_COOKIE_PATH=/
