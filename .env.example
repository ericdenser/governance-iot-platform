# Copie para .env e preencha:  cp .env.example .env

# ── Host que os devices/browser enxergam ─────────────────────
# Usado para montar URLs públicas (MinIO presigned, FRONTEND_URL,
# GOVAPI_PUBLIC_URL, BFF_PUBLIC_URL). Pode ser IP ou hostname.
HOST_IP=COLOQUE_O_IP_OU_HOSTNAME_AQUI

# ── Postgres ─────────────────────────────────────────────────
# Defaults pra docker network (make setup). Pra mvn spring-boot:run local:
# POSTGRES_HOST=localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
# Um DB por serviço (Postgres unificado, schemas separados)
GOVAPI_DB=cmdb_iot
EVENT_HANDLER_DB=event_handler

# ── Redis (streams e session — pode ser o mesmo container) ───
# HOST/PORT sao para docker-network (nomes de service + porta interna 6379).
# Dev local (mvn spring-boot:run com redis containerizado): override no seu .env:
#   REDIS_STREAMS_HOST=localhost
#   REDIS_STREAMS_PORT=6380  (bind do host)
#   REDIS_SESSION_HOST=localhost
#   REDIS_SESSION_PORT=6379
REDIS_STREAMS_HOST=redis-streams
REDIS_STREAMS_PORT=6379
REDIS_STREAMS_PASSWORD=
REDIS_SESSION_HOST=redis
REDIS_SESSION_PORT=6379
# REPLICA_ID=0

# ── InfluxDB ─────────────────────────────────────────────────
# Docker: influxdb (service name). Local: http://localhost:8086
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=changeme-influx-token
INFLUX_ORG=mackenzie
INFLUX_BUCKET=telemetry_bucket
INFLUX_USERNAME=admin
INFLUX_PASSWORD=changeme

# ── MQTT broker (Mosquitto) ──────────────────────────────────
# docker-network: `mosquitto` 
# dev-local (mvn spring-boot:run): `localhost`
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
# Margem (s) antes do expires_in do token pro agent-mqtt reconectar no broker
MQTT_JWT_REFRESH_MARGIN_S=90

# ── URLs internas (docker network — hostnames de container) ─
# Em dev local (mvn spring-boot:run) troque cada um pra http://localhost:<porta>
GOVAPI_URL=http://govapi:8082
AGENT_MQTT_URL=http://agent-mqtt:8087
EVENT_HANDLER_URL=http://event-handler:8085
DATALOGGER_URL=http://datalogger:8081
BFF_URL=http://bff:8083

# ── URLs públicas (browser/ESP alcançam de fora do docker net) ──
GOVAPI_PUBLIC_URL=http://${HOST_IP}:8082
BFF_PUBLIC_URL=http://${HOST_IP}:8083
FRONTEND_URL=http://${HOST_IP}:5173

# ── Keycloak ─────────────────────────────────────────────────
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/IOT-REALM
KEYCLOAK_ADMIN_URL=http://localhost:8080/admin/realms/IOT-REALM
# KEYCLOAK_ADMIN_PASSWORD=admin
# Senha do user "admin" do IOT-REALM (login no SPA no primeiro boot).
# Default: admin. Troque em produção. User: admin / IOT_ADMIN_PASSWORD.
# IOT_ADMIN_PASSWORD=admin

# ── Clients Keycloak (padrão: {SERVICE}_CLIENT_{ID|SECRET}) ──
GOVAPI_CLIENT_ID=gov-api
GOVAPI_CLIENT_SECRET=changeme
# TTL (segundos) do access token de cada device criado no Keycloak.
# Default 300 (5min).
# DEVICE_TOKEN_LIFESPAN_S=300
AGENT_MQTT_CLIENT_ID=agent-mqtt
AGENT_MQTT_CLIENT_SECRET=changeme
BFF_CLIENT_ID=iot-bff
BFF_CLIENT_SECRET=changeme

# ── MinIO ────────────────────────────────────────────────────
# MINIO_ENDPOINT: govApi acessa (docker: minio, local: localhost)
# MINIO_PUBLIC_ENDPOINT: URL que ESP/browser usa (sempre HOST_IP)
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://${HOST_IP}:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=firmware
MINIO_REGION=us-east-1

# ── Provisionamento (NVS binary + bootloader) ────────────────
# Deploy Docker: deixe as duas linhas vazias/comentadas — o compose usa
# defaults do venv isolado da imagem (/opt/nvs-venv/bin/python3, sem script).
#
# Dev local (mvn spring-boot:run):
#   Opção A — ESP-IDF instalado:
#     NVS_PYTHON_PATH=~/.espressif/tools/python/<ver>/venv/bin/python3
#     NVS_SCRIPT_PATH=~/.espressif/<ver>/esp-idf/components/nvs_flash/nvs_partition_generator/nvs_partition_gen.py
#   Opção B — venv local via pip (`python3 -m venv .venv-nvs && .venv-nvs/bin/pip install esp-idf-nvs-partition-gen`):
#     NVS_PYTHON_PATH=./.venv-nvs/bin/python3
#     NVS_SCRIPT_PATH=
# NVS_PYTHON_PATH=
# NVS_SCRIPT_PATH=
# Volume do host com os bins da plataforma ESP32 (bootloader + partition-table).
# Coloque os .bin em platform-bins/ e rode `make upload-bin` pra publicar no MinIO.
PROVISIONING_BINS_VOLUME=./platform-bins
PROVISIONING_BOOTLOADER_BIN_PATH=/opt/provisioning-bins/bootloader.bin
PROVISIONING_PARTITION_TABLE_BIN_PATH=/opt/provisioning-bins/partition-table.bin

# ── OTA broadcast em waves (docs/OTA_ROLLOUT_TUNING.md) ──────
BROADCAST_WAVE_THRESHOLD=100
BROADCAST_WAVE_SIZE=50
BROADCAST_WAVE_INTERVAL_MS=10000

# ============================================================
# DEPLOY DOCKER (opcional — só se usar os docker-compose.yml
# dos serviços; ignore para dev com mvn spring-boot:run)
# ============================================================

# Nomes dos containers (usados também nas URLs internas acima
# quando subir via docker compose; ex: GOVAPI_URL=http://iot-govapi:8082)
GOVAPI_CONTAINER_NAME=govapi
AGENT_MQTT_CONTAINER_NAME=agent-mqtt
EVENT_HANDLER_CONTAINER_NAME=event-handler
DATALOGGER_CONTAINER_NAME=datalogger
BFF_CONTAINER_NAME=bff
SPA_CONTAINER_NAME=spa

# Portas bind no host (defaults iguais às portas do container)
# GOVAPI_HOST_PORT=8082
# GOVAPI_HOST_BIND=127.0.0.1
# BFF_HOST_PORT=8083
# SPA_HOST_PORT=5173      

# Limites de RAM (apps)
# GOVAPI_MEMORY_LIMIT=640M
# AGENT_MQTT_MEMORY_LIMIT=512M
# EVENT_HANDLER_MEMORY_LIMIT=512M
# DATALOGGER_MEMORY_LIMIT=448M
# BFF_MEMORY_LIMIT=512M
# SPA_MEMORY_LIMIT=64M

# Limites de RAM (infra)
# MOSQUITTO_MEMORY_LIMIT=128M
# POSTGRES_MEMORY_LIMIT=512M
# REDIS_MEMORY_LIMIT=128M
# REDIS_STREAMS_MEMORY_LIMIT=640M
# MINIO_MEMORY_LIMIT=256M
# INFLUXDB_MEMORY_LIMIT=512M
# KEYCLOAK_MEMORY_LIMIT=768M

# JVM args (ex: heap tuning, remote debug)
# JAVA_TOOL_OPTIONS=-Xmx512m

# Rede docker compartilhada entre composes.
# Default true: Makefile cria a rede via `make net` antes de subir os composes.
# Override pra false apenas se subir os composes um a um SEM passar pelo Makefile
# (aí um dos composes cria a rede sozinho e os outros herdam).
DOCKER_NETWORK=app-net
DOCKER_NETWORK_EXTERNAL=true

# BFF session cookie (prod HTTPS: Secure=true, SameSite=None)
# APP_SESSION_COOKIE_SECURE=false
# APP_SESSION_COOKIE_SAME_SITE=Lax
# APP_SESSION_COOKIE_PATH=/

# BFF log verbosity (Spring Security / OAuth2). Default WARN.
# LOG_LEVEL_OAUTH=WARN
# LOG_LEVEL_SECURITY=WARN

# SPA build
# SPA_BASE_PATH=/
# NPM_PROXY_URL=

# Proxy corporativo pro build (Maven + apk + pip)
PROXY_ACTIVE=false
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASSWORD=
# Usado por apk/pip no runtime stage do Dockerfile do govApi.
# Ex: PROXY_URL=http://user:pass@host:port
PROXY_URL=
